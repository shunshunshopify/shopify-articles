{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:www.shopify.com)",
      "WebFetch(domain:playbit.co.jp)",
      "WebFetch(domain:d2c.mynavi.jp)",
      "WebFetch(domain:www.kolenda.io)",
      "WebFetch(domain:www.profuture.co.jp)",
      "Bash(python3 -c ' *)",
      "Bash(python3)",
      "Task",
      "Read",
      "Write",
      "mcp__claude_ai_Shopify__validate_graphql_codeblocks",
      "mcp__claude_ai_Shopify__graphql_schema",
      "mcp__claude_ai_Shopify__graphql_query",
      "mcp__claude_ai_Google_Drive__search_files",
      "mcp__claude_ai_Google_Drive__read_file_content"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__graphql_mutation",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}/scripts/shopify_publish_guard.py\"",
            "statusMessage": "Shopify mutation の下書き指定を検査中..."
          }
        ]
      }
    ]
  }
}
